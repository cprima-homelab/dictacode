[Unit]
Description=dictacode Speech-to-Text Pipeline
Documentation=https://github.com/cprima-homelab/dictacode
After=network.target sound.target
Wants=network.target

[Service]
Type=notify

# Run as non-root service user
User=dictacode
Group=dictacode

# systemd-managed state/log dirs
StateDirectory=dictacode
RuntimeDirectory=dictacode
LogsDirectory=dictacode

# v0.2.3 DEV: Use development paths (toggle to packaged paths when building release)
WorkingDirectory=/home/dictacode/dictacode/apps/stt

# STT pipeline executable (v0.2.3: service always starts, state machine handles lifecycle)
ExecStart=/home/dictacode/dictacode/apps/stt/.venv/bin/python -m dictacode_stt

# Watchdog: systemd will restart if no WATCHDOG=1 within 60s
WatchdogSec=60

Restart=on-failure
RestartSec=3

# v0.2.3: State polling intervals
Environment=DICTACODE_PREREQUISITE_POLL=30
Environment=DICTACODE_LINK_POLL=5
Environment=DICTACODE_HANDSHAKE_TIMEOUT=10
# v0.3.7: IPC socket path (matches code default)
# Environment=DICTACODE_IPC_SOCKET=/run/dictacode/diag.sock

EnvironmentFile=-/etc/dictacode/stt.env
Environment=PYTHONUNBUFFERED=1

# Security hardening (v0.2.3 DEV: ProtectHome disabled for ~/dictacode access)
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false

# Audio processing priority
Nice=-5

StandardOutput=journal
StandardError=journal
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
