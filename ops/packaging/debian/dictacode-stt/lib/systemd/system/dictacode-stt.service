[Unit]
Description=dictacode Speech-to-Text Pipeline
Documentation=https://github.com/cprima-homelab/dictacode
After=network.target sound.target
Wants=network.target

[Service]
Type=simple

# Run as non-root service user
User=dictacode
Group=dictacode

# systemd-managed state/log dirs
StateDirectory=dictacode
RuntimeDirectory=dictacode-stt
LogsDirectory=dictacode

WorkingDirectory=/opt/dictacode/stt

# STT pipeline executable
# Note: Requires whisper.cpp to be installed first via install-whisper.sh
ExecStart=/opt/dictacode/stt/stt-venv/bin/python /opt/dictacode/stt/pipeline_stream.py

Restart=on-failure
RestartSec=3

EnvironmentFile=-/etc/dictacode/stt.env
Environment=PYTHONUNBUFFERED=1

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

# Audio processing priority
Nice=-5

StandardOutput=journal
StandardError=journal
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
