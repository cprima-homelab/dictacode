[Unit]
Description=dictacode Speech-to-Text Pipeline
Documentation=https://github.com/cprima-homelab/dictacode
After=network.target sound.target
Wants=network.target

[Service]
Type=notify

# Run as non-root service user
User=dictacode
Group=dictacode

# systemd-managed state/log dirs
StateDirectory=dictacode
RuntimeDirectory=dictacode-stt
LogsDirectory=dictacode

WorkingDirectory=/opt/dictacode/stt

# Hardware check before start (exit 1 = don't start, exit 2 = warn but start)
ExecStartPre=/opt/dictacode/stt/stt-venv/bin/dictacode-stt-check --quiet

# STT pipeline executable
ExecStart=/opt/dictacode/stt/stt-venv/bin/python -m dictacode_stt

# Watchdog: systemd will restart if no WATCHDOG=1 within 60s
WatchdogSec=60

Restart=on-failure
RestartSec=3

EnvironmentFile=-/etc/dictacode/stt.env
Environment=PYTHONUNBUFFERED=1

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

# Audio processing priority
Nice=-5

StandardOutput=journal
StandardError=journal
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
