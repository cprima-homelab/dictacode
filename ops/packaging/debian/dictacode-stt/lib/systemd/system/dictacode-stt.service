[Unit]
Description=dictacode Speech-to-Text Pipeline
Documentation=https://github.com/cprima-homelab/dictacode
After=network.target sound.target
Wants=network.target

[Service]
Type=notify

# Run as non-root service user
User=dictacode
Group=dictacode

# systemd-managed state/log dirs
StateDirectory=dictacode
RuntimeDirectory=dictacode-stt
LogsDirectory=dictacode

WorkingDirectory=/opt/dictacode/stt

# STT pipeline executable (v0.2.3: service always starts, state machine handles lifecycle)
ExecStart=/opt/dictacode/stt/stt-venv/bin/python -m dictacode_stt

# Watchdog: systemd will restart if no WATCHDOG=1 within 60s
WatchdogSec=60

Restart=on-failure
RestartSec=3

# v0.2.3: State polling intervals
Environment=DICTACODE_PREREQUISITE_POLL=30
Environment=DICTACODE_LINK_POLL=5
Environment=DICTACODE_HANDSHAKE_TIMEOUT=10

EnvironmentFile=-/etc/dictacode/stt.env
Environment=PYTHONUNBUFFERED=1

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

# Audio processing priority
Nice=-5

StandardOutput=journal
StandardError=journal
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
