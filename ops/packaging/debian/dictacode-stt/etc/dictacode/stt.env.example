# dictacode STT Environment Variables
#
# Copy to /etc/dictacode/stt.env to customize
# These override config file settings but are overridden by CLI arguments
#
# Precedence: CLI args > Environment > Config file > Defaults

# Main Service Prometheus Metrics
#DICTACODE_METRICS_ENABLED=true
#DICTACODE_METRICS_PORT=9100

# API Server Settings
#DICTACODE_API_HOST=127.0.0.1
#DICTACODE_API_PORT=8000
#DICTACODE_API_CONFIG_DIR=/etc/dictacode/audio

# API Server Prometheus Metrics
#DICTACODE_API_METRICS_ENABLED=true
#DICTACODE_API_METRICS_PORT=9101

# SECURITY WARNING:
# Setting DICTACODE_API_HOST to 0.0.0.0 exposes the API to all network interfaces
# The API has NO AUTHENTICATION - only use in trusted networks
