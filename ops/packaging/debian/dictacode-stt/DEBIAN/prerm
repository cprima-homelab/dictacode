#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Stop and disable service
        if systemctl is-active --quiet dictacode-stt.service 2>/dev/null; then
            echo "Stopping dictacode-stt service..."
            systemctl stop dictacode-stt.service || true
        fi
        if systemctl is-enabled --quiet dictacode-stt.service 2>/dev/null; then
            echo "Disabling dictacode-stt service..."
            systemctl disable dictacode-stt.service || true
        fi
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
