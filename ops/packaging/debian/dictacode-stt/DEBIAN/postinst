#!/bin/sh
set -e

case "$1" in
    configure)
        echo "=== dictacode-stt post-installation ==="

        # Set permissions on scripts
        chmod 755 /opt/dictacode/stt/install-whisper.sh

        # Ensure drop-in directory exists and has correct permissions (v0.3.2)
        mkdir -p /etc/dictacode/stt.d
        chmod 755 /etc/dictacode/stt.d

        # Set ownership
        if id dictacode > /dev/null 2>&1; then
            chown -R dictacode:dictacode /opt/dictacode/stt
            chown dictacode:dictacode /etc/dictacode/stt.d 2>/dev/null || true
        fi

        # Reload systemd
        systemctl daemon-reload

        echo ""
        echo "Installation complete."
        echo ""
        echo "Next steps:"
        echo "  1. Edit /etc/dictacode/stt.conf to configure:"
        echo "     - Prometheus metrics (metrics_enabled=true)"
        echo "     - API server settings (api_host, api_port)"
        echo "  2. Build whisper.cpp:"
        echo "     sudo /opt/dictacode/stt/install-whisper.sh"
        echo "  3. Start the main STT service:"
        echo "     sudo systemctl enable --now dictacode-stt"
        echo "  4. Optionally start the API server:"
        echo "     sudo systemctl enable --now dictacode-stt-api"
        echo ""
        echo "SECURITY NOTE:"
        echo "  The API server provides UNAUTHENTICATED access to:"
        echo "    - Audio configuration"
        echo "    - Transcription control"
        echo "  Default: binds to localhost (127.0.0.1) only"
        echo "  See /etc/dictacode/stt.env.example for configuration"
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
