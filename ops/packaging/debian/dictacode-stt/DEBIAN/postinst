#!/bin/sh
set -e

case "$1" in
    configure)
        echo "=== dictacode-stt post-installation ==="

        # Set permissions on scripts
        chmod 755 /opt/dictacode/stt/install-whisper.sh

        # Set ownership
        if id dictacode > /dev/null 2>&1; then
            chown -R dictacode:dictacode /opt/dictacode/stt
        fi

        # Reload systemd
        systemctl daemon-reload

        echo ""
        echo "Installation complete."
        echo ""
        echo "Next steps:"
        echo "  1. Edit /etc/dictacode/stt.conf (optional)"
        echo "  2. Build whisper.cpp:"
        echo "     sudo /opt/dictacode/stt/install-whisper.sh"
        echo "  3. Start the service:"
        echo "     sudo systemctl enable --now dictacode-stt"
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
