[Unit]
Description=dictacode HID Bridge - UART to HID keyboard
Documentation=https://github.com/cprima-homelab/dictacode
After=dictacode-hid-gadget.service
Requires=dictacode-hid-gadget.service
ConditionPathExists=/dev/hidg0

[Service]
Type=notify

# Run as non-root service user
User=dictacode
Group=dictacode

# systemd-managed state/log dirs
StateDirectory=dictacode
RuntimeDirectory=dictacode-hid
LogsDirectory=dictacode

# v0.2.3 DEV: Use development paths
WorkingDirectory=/home/dictacode/dictacode/apps/hid

# HID bridge executable (v0.2.3: service always starts, state machine handles lifecycle)
ExecStart=/home/dictacode/dictacode/apps/hid/.venv/bin/python -m dictacode_hid

# Watchdog: systemd will restart if no WATCHDOG=1 within 60s
WatchdogSec=60

Restart=on-failure
RestartSec=3

EnvironmentFile=-/etc/dictacode/hid.env
Environment=PYTHONUNBUFFERED=1

# Security hardening (v0.2.3 DEV: ProtectHome disabled for ~/dictacode access)
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false

StandardOutput=journal
StandardError=journal
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
