[Unit]
Description=dictacode HID Bridge - UART to HID keyboard
Documentation=https://github.com/cprima-homelab/dictacode
After=dictacode-hid-gadget.service
Requires=dictacode-hid-gadget.service
ConditionPathExists=/dev/hidg0

[Service]
Type=notify

# Run as non-root service user
User=dictacode
Group=dictacode

# systemd-managed state/log dirs
StateDirectory=dictacode
RuntimeDirectory=dictacode-hid
LogsDirectory=dictacode

WorkingDirectory=/opt/dictacode/hid

# Hardware check before start (exit 1 = don't start, exit 2 = warn but start)
ExecStartPre=/opt/dictacode/hid/hid-venv/bin/dictacode-hid-check --quiet

# HID bridge executable
ExecStart=/opt/dictacode/hid/hid-venv/bin/python -m dictacode_hid

# Watchdog: systemd will restart if no WATCHDOG=1 within 60s
WatchdogSec=60

Restart=on-failure
RestartSec=3

EnvironmentFile=-/etc/dictacode/hid.env
Environment=PYTHONUNBUFFERED=1

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

StandardOutput=journal
StandardError=journal
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
